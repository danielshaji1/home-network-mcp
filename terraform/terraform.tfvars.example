    dhcp_end        = "10.0.1.200"
    purpose         = "management"
    isolation_level = "restricted"
    dns_servers     = ["10.0.1.15", "1.1.1.1"]
  },
  {
    vlan_id         = 10
    name            = "Trusted_LAN"
    subnet_cidr     = "10.0.10.0/24"
