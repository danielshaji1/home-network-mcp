# NetWarden Environment Configuration
NETWARDEN_CONFIG=examples/multi_brand_hybrid.yaml
NETWARDEN_PORT=8000
NETWARDEN_TRANSPORT=stdio

# Device Credentials (can be passed via environment variables)
UNIFI_CONTROLLER_URL=https://10.0.1.2
UNIFI_USERNAME=admin
UNIFI_PASSWORD=secret_password

MIKROTIK_HOST=10.0.1.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=secret_password

OPNSENSE_HOST=10.0.1.3
OPNSENSE_KEY=api_key_here
OPNSENSE_SECRET=api_secret_here

PIHOLE_HOST=10.0.1.15
PIHOLE_TOKEN=api_token_here
